# ==========================================================
# Configuración SMTP para SysMonitor IoT (copia este archivo a .env)
# Si SMTP_USER y SMTP_PASS están vacíos, los correos se guardan
# en la tabla correos_enviados (estado: cola_local_auditable).
# ==========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@sysmonitor.com
SMTP_FROM_NAME="SysMonitor IoT Seguridad"
SMTP_ADMIN_EMAIL=admin@sysmonitor.com
